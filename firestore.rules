rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "prasadadvocatek@gmail.com" && 
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 2: Validation Blueprints
    function isValidReview(data) {
      return data.keys().hasAll(['rating', 'comment', 'userId', 'createdAt']) &&
             data.keys().size() >= 4 && // can have userName, userPhoto
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // Phase 4: Collection Rules
    match /reviews/{reviewId} {
      allow list: if true; // Everyone can see reviews
      allow get: if true;

      allow create: if isSignedIn() && 
                      isValidId(reviewId) && 
                      isValidReview(incoming());

      allow update: if false; // Reviews are immutable for now to prevent editing someone else's content or spoofing IDs

      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }
  }
}
